#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT_DIR"

if [ -x "$ROOT_DIR/.venv/bin/python" ]; then
    exec "$ROOT_DIR/.venv/bin/python" -u -m webapp "$@"
fi

if command -v uv >/dev/null 2>&1; then
    exec uv run python -u -m webapp "$@"
fi

echo "Error: Python environment was not found." >&2
echo "Install uv and run 'uv sync' first." >&2
exit 1
